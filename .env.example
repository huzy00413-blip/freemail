# rebind-service 环境变量配置
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 包含敏感密钥，已加入 .gitignore，切勿提交

# 必填：Worker 与 rebind-service 共享密钥（openssl rand -hex 32）
REBIND_SERVICE_TOKEN=
# 必填：任务终态回调密钥（openssl rand -hex 32）
REBIND_CALLBACK_TOKEN=
# 必填：Worker 回调地址
WORKER_TASK_CALLBACK_URL=https://mailfree.1842068403.workers.dev/rebind/task-terminal
# 必填：Worker API 基址
REBIND_WORKER_API_BASE=https://mailfree.1842068403.workers.dev

# 可选：并发控制
REBIND_MAX_CONCURRENT=3
MAX_WAITING=10
REBIND_BUNDLE_TTL=3600
# 可选：代理默认协议
PROXY_DEFAULT_SCHEME=socks5h
